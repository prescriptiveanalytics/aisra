# Network Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
MQTT_HOST=localhost
MQTT_PORT=1883
SERVER_REST_PORT=5000
SERVER_GRPC_PORT=5001
AGENT_PORT=5003
FRONTEND_PORT=3000

# Backend Configuration
CLIENT_TYPE=Grpc # Options: Lib, Grpc
LLM_API_KEY=sk-or-v1-...
LLM_CLIENT=OpenAi # Options: OpenAi, Ollama
HEURISTIC_LIB_SERVER_URL=https://localhost:5001
MODEL=openrouter/free
MODEL_ENDPOINT=https://openrouter.ai/api/v1/ # e.g. http://localhost:11434/ for Ollama

# Authentication (Google)
USE_AUTHENTICATION=true # Set to false to disable sign-in entirely
# Only users whose verified email address matches this RegEx (case-insensitive) are granted access.
AUTHORIZED_USERS_REGEX=^[^@]+@example\.com$
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# URL of the frontend. Used for CORS and as the redirect target after sign-in/sign-out.
# For the SvelteKit dev server use http://localhost:5173.
FRONTEND_URL=http://localhost:${FRONTEND_PORT}

# Frontend Configuration
# Base URL the browser uses to reach the API.
# For local Docker use https://localhost:${AGENT_PORT}.
# Behind a reverse proxy on the same origin, use the public origin, e.g. https://example.com
PUBLIC_API_URL=https://localhost:${AGENT_PORT}
